<Window x:Class="Tarsier.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Tarsier.App.ViewModels"
        xmlns:views="clr-namespace:Tarsier.App.Views"
        Title="Tarsier"
        Width="880"
        Height="580"
        MinWidth="760"
        MinHeight="500"
        FontSize="12"
        Foreground="{StaticResource TextBrush}"
        Background="{StaticResource WindowBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <vm:NullToVisibilityConverter x:Key="NullToVisibility" />

        <Style TargetType="TextBlock" x:Key="SectionHeading">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style TargetType="TextBlock" x:Key="Caption">
            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
            <Setter Property="Minimum" Value="-100" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="TickFrequency" Value="1" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0"
                Padding="14,10">
            <DockPanel>
                <ToggleButton x:Name="SettingsToggle"
                              DockPanel.Dock="Right"
                              Content="Settings"
                              Padding="12,5" />
                <CheckBox Content="Pause all profiles"
                          VerticalAlignment="Center"
                          IsChecked="{Binding IsPaused}" />
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,1,0,0"
                Padding="14,12"
                Visibility="{Binding IsChecked, ElementName=SettingsToggle, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <CheckBox Content="Start with Windows"
                          IsChecked="{Binding StartsWithWindows}"
                          Margin="0,0,0,14" />

                <DockPanel Margin="0,0,0,4">
                    <Button DockPanel.Dock="Right"
                            Content="Enable full range"
                            VerticalAlignment="Center"
                            Command="{Binding EnableFullRangeCommand}"
                            Visibility="{Binding IsFullRangeMissing, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock VerticalAlignment="Center">
                        <Run Text="Full gamma range:" FontWeight="SemiBold" />
                        <Run Text="{Binding FullRangeStatus, Mode=OneWay}" />
                    </TextBlock>
                </DockPanel>
                <TextBlock Style="{StaticResource Caption}"
                           TextWrapping="Wrap"
                           Text="Windows limits how far the gamma ramp may move; past a moderate setting the sliders stop having any effect. The default range covers most needs. Enabling the full range writes one system setting, needs administrator approval, and takes effect after you sign out and back in." />

                <TextBlock Style="{StaticResource Caption}"
                           HorizontalAlignment="Right"
                           Margin="0,10,0,0"
                           Text="{Binding Version, Mode=OneTime}" />
            </StackPanel>
        </Border>

        <Grid Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="0,0,14,0">
                <TextBlock DockPanel.Dock="Top" Text="Profiles" Style="{StaticResource SectionHeading}" />
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Add..." Margin="0" Command="{Binding AddProfileCommand}" />
                    <Button Content="Remove" Command="{Binding RemoveProfileCommand}" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Profiles}"
                         SelectedItem="{Binding SelectedProfile}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,8,0"
                                       VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"
                                       Visibility="{Binding Icon, Converter={StaticResource NullToVisibility}}" />
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ExecutableName}" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <Grid Grid.Column="1"
                  Visibility="{Binding SelectedProfile, Converter={StaticResource NullToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource PanelCorner}"
                        Padding="18">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel DataContext="{Binding SelectedProfile}">
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Name" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>

                            <CheckBox Content="Profile enabled" IsChecked="{Binding Enabled}" Margin="90,0,0,18" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="46" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="40" />
                                    <RowDefinition Height="40" />
                                    <RowDefinition Height="40" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Gamma" VerticalAlignment="Center" />
                                <Slider Grid.Row="0" Grid.Column="1" Value="{Binding Gamma}" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Gamma}" VerticalAlignment="Center" TextAlignment="Right" />
                                <Button Grid.Row="0" Grid.Column="3" Content="Reset" VerticalAlignment="Center" Command="{Binding ResetGammaCommand}" />

                                <TextBlock Grid.Row="1" Text="Brightness" VerticalAlignment="Center" />
                                <Slider Grid.Row="1" Grid.Column="1" Value="{Binding Brightness}" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Brightness}" VerticalAlignment="Center" TextAlignment="Right" />
                                <Button Grid.Row="1" Grid.Column="3" Content="Reset" VerticalAlignment="Center" Command="{Binding ResetBrightnessCommand}" />

                                <TextBlock Grid.Row="2" Text="Contrast" VerticalAlignment="Center" />
                                <Slider Grid.Row="2" Grid.Column="1" Value="{Binding Contrast}" />
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Contrast}" VerticalAlignment="Center" TextAlignment="Right" />
                                <Button Grid.Row="2" Grid.Column="3" Content="Reset" VerticalAlignment="Center" Command="{Binding ResetContrastCommand}" />
                            </Grid>

                            <Grid Visibility="{Binding DataContext.IsVibranceSupported, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="46" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="40" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="Vibrance" VerticalAlignment="Center" />
                                <Slider Grid.Column="1" Value="{Binding Vibrance}" />
                                <TextBlock Grid.Column="2" Text="{Binding Vibrance}" VerticalAlignment="Center" TextAlignment="Right" />
                                <Button Grid.Column="3" Content="Reset" VerticalAlignment="Center" Command="{Binding ResetVibranceCommand}" />
                            </Grid>

                            <TextBlock Text="0 leaves the display untouched."
                                       Style="{StaticResource Caption}"
                                       Margin="90,0,0,22" />

                            <TextBlock Text="Hotkeys" Style="{StaticResource SectionHeading}" />
                            <Grid Margin="0,0,0,8">
                                <Grid.Resources>
                                    <DataTemplate x:Key="HotkeyBox">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <views:HotkeyBox Width="220"
                                                             Style="{StaticResource {x:Type TextBox}}"
                                                             Text="{Binding Text, Mode=OneWay}" />
                                            <Button Content="Clear" Command="{Binding ClearCommand}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </Grid.Resources>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="90" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,6">
                                    <TextBlock Text="Toggle" VerticalAlignment="Center" />
                                    <ContentControl Style="{StaticResource HelpMark}" ToolTip="Turns this profile on and off." />
                                </StackPanel>
                                <ContentControl Grid.Row="0" Grid.Column="1" Content="{Binding ToggleHotkey}" ContentTemplate="{StaticResource HotkeyBox}" />

                                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,6">
                                    <TextBlock Text="Increase intensity" VerticalAlignment="Center" />
                                    <ContentControl Style="{StaticResource HelpMark}" ToolTip="Temporarily increases the filters' intensity, cancel to revert changes." />
                                </StackPanel>
                                <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding IncreaseIntensityHotkey}" ContentTemplate="{StaticResource HotkeyBox}" />

                                <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,6">
                                    <TextBlock Text="Decrease intensity" VerticalAlignment="Center" />
                                    <ContentControl Style="{StaticResource HelpMark}" ToolTip="Temporarily decreases the filters' intensity, cancel to revert changes." />
                                </StackPanel>
                                <ContentControl Grid.Row="2" Grid.Column="1" Content="{Binding DecreaseIntensityHotkey}" ContentTemplate="{StaticResource HotkeyBox}" />
                            </Grid>
                            <TextBlock Style="{StaticResource Caption}"
                                       TextWrapping="Wrap"
                                       Text="Click a box, then press any combination of keys, mouse buttons and the wheel. Hotkeys work while this profile's application is in the foreground." />
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <StackPanel Grid.Row="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,12,0,0">
                    <CheckBox Content="Preview on this monitor"
                              VerticalAlignment="Center"
                              IsChecked="{Binding IsPreviewEnabled}" />
                    <Button Content="Cancel"
                            MinWidth="90"
                            Command="{Binding CancelEditsCommand}" />
                    <Button Content="Save"
                            MinWidth="90"
                            Margin="6,0,0,0"
                            Style="{StaticResource AccentButton}"
                            Command="{Binding SaveProfileCommand}" />
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
