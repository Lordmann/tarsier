<Window x:Class="Tarsier.App.Views.ConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="400"
        SizeToContent="Height"
        FontSize="12"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Foreground="{StaticResource TextBrush}"
        Background="{StaticResource WindowBrush}">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" MinWidth="84" IsCancel="True" />
            <Button x:Name="ConfirmButton"
                    MinWidth="84"
                    Margin="8,0,0,0"
                    Style="{StaticResource AccentButton}"
                    IsDefault="True"
                    Click="OnConfirm" />
        </StackPanel>

        <TextBlock x:Name="Message" TextWrapping="Wrap" />
    </DockPanel>
</Window>
