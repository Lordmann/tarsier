<Window x:Class="Tarsier.App.Views.AppPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose an application"
        Width="460"
        Height="440"
        FontSize="12"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Foreground="{StaticResource TextBrush}"
        Background="{StaticResource WindowBrush}">
    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Top"
                   Margin="0,0,0,10"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource MutedTextBrush}"
                   Text="Pick one of the applications that currently has a window open. The profile is bound to its executable name." />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" MinWidth="84" IsCancel="True" />
            <Button Content="Add"
                    MinWidth="84"
                    Margin="8,0,0,0"
                    Style="{StaticResource AccentButton}"
                    IsDefault="True"
                    Click="OnAccept" />
        </StackPanel>

        <ListBox x:Name="ApplicationList" MouseDoubleClick="OnAccept">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ExecutableName}" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
