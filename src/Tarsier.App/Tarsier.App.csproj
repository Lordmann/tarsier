<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Tarsier</AssemblyName>
    <RootNamespace>Tarsier.App</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Velopack must run before WPF, so App.xaml.cs owns Main instead of the generated one. -->
    <StartupObject>Tarsier.App.App</StartupObject>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\tray-on-light.ico" />
    <Resource Include="Assets\tray-on-dark.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tarsier.Core\Tarsier.Core.csproj" />
  </ItemGroup>

</Project>
